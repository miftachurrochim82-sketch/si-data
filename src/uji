<script>
// =============================================
// J_Core.html — State, Helpers, Pagination, Sidebar, Filter, Cascade
// =============================================

// =============================================
// STATE GLOBAL
// =============================================
let currentFilter = '';
let currentPage = 'dashboard';
let masterOptions = null;
let kegiatanData = [];
let pegawaiData = [];
let logbookData = [];
let editingKegiatanId = null;
let currentDetailKegiatanId = null;
let crossTabData = null;
let pesertaTemp = [];
let filterState = { tahun: '', bulan: '', bidangId: '' };
let deferredInstallPrompt = null;

const GRUP_COLORS = {
  'Pencegahan':                            '#2d5a87',
  'Penanganan':                            '#e67e22',
  'Satlinmas':                             '#27ae60',
  'Kerjasama':                             '#8e44ad',
  'P3 Gakda':                              '#c0392b',
  'Penyelidikan & Penindakan':             '#16a085',
  'Pencegahan & Penanggulangan Kebakaran': '#f39c12',
  'Penyelamatan Kebakaran':                '#2980b9'
};

// =============================================
// HELPERS
// =============================================
function formatNumber(n) { return new Intl.NumberFormat('id-ID').format(n || 0); }

function formatRupiah(n) {
  n = n || 0;
  if (n >= 1_000_000_000) return 'Rp ' + (n / 1_000_000_000).toFixed(1) + ' M';
  if (n >= 1_000_000) return 'Rp ' + (n / 1_000_000).toFixed(1) + ' Jt';
  if (n >= 1_000) return 'Rp ' + (n / 1_000).toFixed(0) + ' Rb';
  return 'Rp ' + formatNumber(n);
}

function formatFileSize(bytes) {
  if (bytes < 1024) return bytes + ' B';
  if (bytes < 1024 * 1024) return (bytes / 1024).toFixed(1) + ' KB';
  return (bytes / (1024 * 1024)).toFixed(2) + ' MB';
}

function destroyChart(id) {
  const el = document.getElementById(id);
  if (!el) return;
  const chart = Chart.getChart(el);
  if (chart) chart.destroy();
}

function escapeHtml(s) {
  return String(s || '').replace(/[&<>"']/g, m => ({
    '&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'
  }[m]));
}

function showToast(msg, isError) {
  const t = document.createElement('div');
  t.className = 'toast' + (isError ? ' error' : '');
  t.textContent = msg;
  document.body.appendChild(t);
  setTimeout(() => t.classList.add('show'), 50);
  setTimeout(() => {
    t.classList.remove('show');
    setTimeout(() => t.remove(), 300);
  }, 3000);
}

function fillSelect(id, arr, labelKey, placeholder) {
  const sel = document.getElementById(id);
  if (!sel) return;
  const current = sel.value;
  sel.innerHTML = '<option value="">' + (placeholder || '— Pilih —') + '</option>';
  arr.forEach(item => {
    const o = document.createElement('option');
    o.value = item.id;
    o.textContent = item[labelKey] || item.nama || item.label || item.id;
    sel.appendChild(o);
  });
  sel.value = current;
}

// =============================================
// PAGINATION
// =============================================
function paginate(arr, page, perPage) {
  const start = (page - 1) * perPage;
  return arr.slice(start, start + perPage);
}

function renderPagination(containerId, total, currentPage, perPage, onPageChange) {
  const el = document.getElementById(containerId);
  if (!el) return;
  if (total === 0) { el.innerHTML = ''; return; }

  const totalPages = Math.ceil(total / perPage);
  const start = (currentPage - 1) * perPage + 1;
  const end = Math.min(currentPage * perPage, total);

  let html = '<div class="pagination-info">Menampilkan <strong>' + start + '-' + end + '</strong> dari <strong>' + total + '</strong> data</div>';
  html += '<div class="pagination-controls">';

  html += '<select class="page-size-select" onchange="changePageSize(\'' + containerId + '\', this.value)">';
  [10, 25, 50, 100].forEach(n => {
    html += '<option value="' + n + '"' + (n === perPage ? ' selected' : '') + '>' + n + ' / hal</option>';
  });
  html += '</select>';

  html += '<button class="page-btn" ' + (currentPage <= 1 ? 'disabled' : '') + ' onclick="gotoPage(\'' + containerId + '\', ' + (currentPage - 1) + ')">‹</button>';

  const pages = [];
  let startPage = Math.max(1, currentPage - 2);
  let endPage = Math.min(totalPages, startPage + 4);
  if (endPage - startPage < 4) startPage = Math.max(1, endPage - 4);

  if (startPage > 1) { pages.push(1); if (startPage > 2) pages.push('...'); }
  for (let i = startPage; i <= endPage; i++) pages.push(i);
  if (endPage < totalPages) {
    if (endPage < totalPages - 1) pages.push('...');
    pages.push(totalPages);
  }

  pages.forEach(p => {
    if (p === '...') html += '<span class="page-ellipsis">…</span>';
    else html += '<button class="page-btn ' + (p === currentPage ? 'active' : '') + '" onclick="gotoPage(\'' + containerId + '\', ' + p + ')">' + p + '</button>';
  });

  html += '<button class="page-btn" ' + (currentPage >= totalPages ? 'disabled' : '') + ' onclick="gotoPage(\'' + containerId + '\', ' + (currentPage + 1) + ')">›</button>';
  html += '</div>';
  el.innerHTML = html;

  window['paginateCallback_' + containerId] = onPageChange;
}

function gotoPage(containerId, page) {
  const cb = window['paginateCallback_' + containerId];
  if (cb) cb(page);
}

function changePageSize(containerId, size) {
  const n = parseInt(size, 10);
  if (containerId === 'paginationKegiatan' && typeof pageKegiatan !== 'undefined') {
    pageKegiatan.perPage = n; pageKegiatan.page = 1; renderKegiatanTable();
  } else if (containerId === 'paginationPegawai' && typeof pagePegawai !== 'undefined') {
    pagePegawai.perPage = n; pagePegawai.page = 1; renderPegawaiTable();
  } else if (containerId === 'paginationLogbook' && typeof pageLogbook !== 'undefined') {
    pageLogbook.perPage = n; pageLogbook.page = 1; renderLogbookTable();
  } else if (containerId === 'paginationAudit' && typeof pageAudit !== 'undefined') {
    pageAudit.perPage = n; pageAudit.page = 1; renderAuditTable();
  }
}

// =============================================
// SIDEBAR
// =============================================
function toggleSidebar() {
  const sidebar = document.getElementById('sidebar');
  if (!sidebar) return;
  sidebar.classList.toggle('collapsed');
  try {
    localStorage.setItem('sidebar-collapsed',
      sidebar.classList.contains('collapsed') ? '1' : '0');
  } catch (e) {}
}

function toggleSidebarMobile() {
  const sidebar = document.getElementById('sidebar');
  const overlay = document.getElementById('sidebarOverlay');
  if (!sidebar) return;
  sidebar.classList.toggle('mobile-open');
  if (overlay) overlay.classList.toggle('active');
}

function closeSidebarMobile() {
  const sidebar = document.getElementById('sidebar');
  const overlay = document.getElementById('sidebarOverlay');
  if (sidebar) sidebar.classList.remove('mobile-open');
  if (overlay) overlay.classList.remove('active');
}

// =============================================
// PWA INSTALL
// =============================================
window.addEventListener('beforeinstallprompt', (e) => {
  e.preventDefault();
  deferredInstallPrompt = e;
  const btn = document.getElementById('btnInstallApp');
  if (btn) btn.style.display = 'flex';
});

function installApp() {
  if (!deferredInstallPrompt) { showInstallInstructions(); return; }
  deferredInstallPrompt.prompt();
  deferredInstallPrompt.userChoice.then((choiceResult) => {
    if (choiceResult.outcome === 'accepted') {
      showToast('✅ Aplikasi dipasang ke home screen');
      const btn = document.getElementById('btnInstallApp');
      if (btn) btn.style.display = 'none';
    }
    deferredInstallPrompt = null;
  });
}

function showInstallInstructions() {
  const isIOS = /iPad|iPhone|iPod/.test(navigator.userAgent);
  const isAndroid = /Android/.test(navigator.userAgent);
  let msg = '';
  if (isIOS) {
    msg = '📲 Cara install di iPhone/iPad:\n\n1. Buka di Safari\n2. Klik tombol Share\n3. Add to Home Screen\n4. Add';
  } else if (isAndroid) {
    msg = '📲 Cara install di Android:\n\n1. Buka di Chrome\n2. Menu ⋮\n3. Install app / Add to Home screen';
  } else {
    msg = '📲 Cara install:\n\n1. Menu browser (⋮)\n2. Install app / Add to Home screen';
  }
  alert(msg);
}

// =============================================
// INIT
// =============================================
document.addEventListener('DOMContentLoaded', function() {
  const el = document.getElementById('tanggalHariIni');
  if (el) el.textContent = new Date().toLocaleDateString('id-ID', {
    weekday: 'long', year: 'numeric', month: 'long', day: 'numeric'
  });

  try {
    if (localStorage.getItem('sidebar-collapsed') === '1') {
      const sb = document.getElementById('sidebar');
      if (sb && window.innerWidth > 900) sb.classList.add('collapsed');
    }
  } catch (e) {}

  // Nav click
  document.querySelectorAll('.nav-item').forEach(btn => {
    btn.addEventListener('click', function() { switchPage(this.dataset.page); });
  });

  // Load master options
  google.script.run
    .withSuccessHandler(function(opt) {
      masterOptions = opt;
      populateFormSelects();
      bindCascade();
    })
    .withFailureHandler(e => console.error('Master options error:', e))
    .getMasterOptions();

  // Load filter options
  google.script.run.withSuccessHandler(initFilter).getFilterOptions();

  // Modal close handlers
  ['modalKegiatan','modalDetail','modalLogbook','modalPeserta','modalTarget','modalUpload'].forEach(id => {
    const m = document.getElementById(id);
    if (m) m.addEventListener('click', e => { if (e.target === m) m.classList.remove('active'); });
  });
  document.addEventListener('keydown', e => {
    if (e.key === 'Escape') {
      document.querySelectorAll('.modal-overlay').forEach(m => m.classList.remove('active'));
    }
  });

  // Online/offline
  window.addEventListener('online', () => showToast('🌐 Koneksi kembali'));
  window.addEventListener('offline', () => showToast('📴 Koneksi terputus', true));
});

// =============================================
// FILTER GLOBAL
// =============================================
function initFilter(options) {
  const selTahun = document.getElementById('filterTahun');
  const selBulan = document.getElementById('filterBulan');
  const selBidang = document.getElementById('filterBidang');

  if (selTahun) {
    options.tahun.forEach(t => {
      const o = document.createElement('option');
      o.value = t; o.textContent = '📅 ' + t;
      selTahun.appendChild(o);
    });
    selTahun.addEventListener('change', function() { filterState.tahun = this.value; onFilterChange(); });
  }

  if (selBulan) {
    options.bulan.forEach(b => {
      const o = document.createElement('option');
      o.value = b.id; o.textContent = '📆 ' + b.nama;
      selBulan.appendChild(o);
    });
    selBulan.addEventListener('change', function() { filterState.bulan = this.value; onFilterChange(); });
  }

  if (selBidang) {
    options.bidang.forEach(b => {
      const o = document.createElement('option');
      o.value = b.id; o.textContent = '🏛️ ' + b.nama;
      selBidang.appendChild(o);
    });
    selBidang.addEventListener('change', function() { filterState.bidangId = this.value; onFilterChange(); });
  }

  loadAll();
}

function onFilterChange() {
  kegiatanData = [];
  logbookData = [];
  loadAll();
  if (currentPage === 'kegiatan') loadKegiatan();
  if (currentPage === 'logbook') loadLogbook();
}

function resetFilter() {
  filterState = { tahun: '', bulan: '', bidangId: '' };
  const t = document.getElementById('filterTahun');
  const b = document.getElementById('filterBulan');
  const d = document.getElementById('filterBidang');
  if (t) t.value = '';
  if (b) b.value = '';
  if (d) d.value = '';
  onFilterChange();
}

// =============================================
// POPULATE FORM SELECTS
// =============================================
function populateFormSelects() {
  if (!masterOptions) return;
  const bidang = masterOptions.allUnits.filter(u => u.jenis_unit === 'BIDANG');
  fillSelect('fBidang', bidang, 'nama', '— Pilih Bidang —');
  fillSelect('fKategori', masterOptions.kategori, 'nama', '— Pilih Kategori —');
  fillSelect('fJenis', masterOptions.jenis, 'nama', '— Pilih Jenis —');
  fillSelect('fPeriode', masterOptions.periode, 'label', '— Pilih Periode —');
  fillSelect('fLokasi', masterOptions.lokasi, 'nama', '— Pilih Lokasi —');
  fillSelect('fSatuan', masterOptions.satuan, 'nama', '— Pilih Satuan —');
}

// =============================================
// CASCADE: Bidang → Seksi → Fungsi
// =============================================
function bindCascade() {
  const selBidang = document.getElementById('fBidang');
  const selSeksi = document.getElementById('fSeksi');
  const selFungsi = document.getElementById('fFungsi');
  if (!selBidang || !selSeksi || !selFungsi) return;

  selBidang.addEventListener('change', function() {
    const bidangId = this.value;
    selSeksi.innerHTML = '<option value="">— Pilih Bidang dulu —</option>';
    selFungsi.innerHTML = '<option value="">— Pilih Seksi dulu —</option>';
    selSeksi.disabled = true; selFungsi.disabled = true;
    if (!bidangId) return;

    const seksi = masterOptions.allUnits.filter(u =>
      u.parent_id === bidangId &&
      (u.jenis_unit === 'SEKSI' || u.jenis_unit === 'SUB_BIDANG')
    );

    if (seksi.length === 0) {
      selSeksi.innerHTML = '<option value="">— Tidak ada seksi —</option>';
      return;
    }
    fillSelect('fSeksi', seksi, 'nama', '— Pilih Seksi —');
    selSeksi.disabled = false;
  });

  selSeksi.addEventListener('change', function() {
    const seksiId = this.value;
    selFungsi.innerHTML = '<option value="">— Pilih Seksi dulu —</option>';
    selFungsi.disabled = true;
    if (!seksiId) return;

    const grupList = masterOptions.allFungsi
      .filter(f => f.unit_id === seksiId && f.level === 1)
      .sort((a, b) => a.urutan - b.urutan);

    if (grupList.length === 0) {
      selFungsi.innerHTML = '<option value="">— Tidak ada fungsi —</option>';
      return;
    }

    let html = '<option value="">— Pilih Fungsi —</option>';
    grupList.forEach(g => {
      html += `<option value="${g.id}">📁 ${escapeHtml(g.nama)}</option>`;
      const subs = masterOptions.allFungsi
        .filter(f => f.parent_id === g.id && f.level === 2)
        .sort((a, b) => a.urutan - b.urutan);
      subs.forEach(s => {
        html += `<option value="${s.id}">&nbsp;&nbsp;&nbsp;&nbsp;└─ ${escapeHtml(s.nama)}</option>`;
      });
    });
    selFungsi.innerHTML = html;
    selFungsi.disabled = false;
  });
}

// =============================================
// NAVIGASI HALAMAN
// =============================================
function switchPage(page) {
  currentPage = page;
  document.querySelectorAll('.page').forEach(p => p.classList.remove('active'));
  document.querySelectorAll('.nav-item').forEach(b => b.classList.remove('active'));
  const pageEl = document.getElementById('page-' + page);
  if (pageEl) pageEl.classList.add('active');
  const navEl = document.querySelector('.nav-item[data-page="' + page + '"]');
  if (navEl) navEl.classList.add('active');

  const titles = {
    dashboard: '📊 Dashboard',
    kegiatan:  '📋 Data Kegiatan',
    pegawai:   '👥 Data Pegawai',
    logbook:   '📝 Logbook',
    analisa:   '📈 Analisa',
    evaluasi:  '🎯 Evaluasi',
    peta:      '🗺️ Peta Sebaran',
    audit:     '📜 Audit Log'
  };
  const titleEl = document.getElementById('pageTitle');
  if (titleEl) titleEl.textContent = titles[page] || page;

  closeSidebarMobile();

  // Lazy load
  if (page === 'kegiatan' && !kegiatanData.length) loadKegiatan();
  if (page === 'pegawai' && !pegawaiData.length) loadPegawai();
  if (page === 'logbook' && !logbookData.length) loadLogbook();
  if (page === 'analisa' && typeof initAnalisaPage === 'function') initAnalisaPage();
  if (page === 'evaluasi' && typeof initEvaluasi === 'function') initEvaluasi();
  if (page === 'audit' && typeof initAudit === 'function') initAudit();
  if (page === 'peta' && typeof initPeta === 'function') initPeta();
}

// =============================================
// LOAD ALL — Dashboard hanya load chart & analitik
// (cross-tab dipindah ke halaman Analisa → tab Matrik)
// =============================================
function loadAll() {
  const f = filterState;

  // Chart dashboard
  google.script.run.withSuccessHandler(renderKPI).withFailureHandler(e => console.error('KPI:', e)).getRingkasan(f);
  google.script.run.withSuccessHandler(renderTrend).withFailureHandler(e => console.error('Trend:', e)).getTrendBulanan(f);
  google.script.run.withSuccessHandler(renderGrup).withFailureHandler(e => console.error('Grup:', e)).getDataPerGrup(f);
  google.script.run.withSuccessHandler(renderUnit).withFailureHandler(e => console.error('Unit:', e)).getDataPerUnit(f);
  google.script.run.withSuccessHandler(renderLokasi).withFailureHandler(e => console.error('Lokasi:', e)).getDataPerLokasi(f);
  google.script.run.withSuccessHandler(renderFungsi).withFailureHandler(e => console.error('Fungsi:', e)).getDataPerFungsi(f);

  // Analitik lanjutan
  google.script.run.withSuccessHandler(renderTopPegawai).withFailureHandler(e => console.error('TopPegawai:', e)).getTopPegawai(f, 10);
  google.script.run.withSuccessHandler(renderLeaderboardUnit).withFailureHandler(e => console.error('Leaderboard:', e)).getLeaderboardUnit(f);
  google.script.run.withSuccessHandler(renderHeatmapBulanGrup).withFailureHandler(e => console.error('Heatmap:', e)).getHeatmapBulanGrup(f);

}
</script>



<script>
// =============================================
// J_Audit.html — Audit Log
// =============================================

let auditData = [];
let pageAudit = { page: 1, perPage: 25 };

// =============================================
// INIT
// =============================================
function initAudit() {
  // Load filter options
  google.script.run.withSuccessHandler(function(opt) {
    const selUser = document.getElementById('auditUser');
    const selAksi = document.getElementById('auditAksi');
    const selTabel = document.getElementById('auditTabel');

    if (selUser) {
      selUser.innerHTML = '<option value="">👤 Semua User</option>';
      opt.users.forEach(u => {
        const o = document.createElement('option');
        o.value = u; o.textContent = u;
        selUser.appendChild(o);
      });
    }

    if (selAksi) {
      selAksi.innerHTML = '<option value="">⚡ Semua Aksi</option>';
      opt.aksi.forEach(a => {
        const o = document.createElement('option');
        o.value = a; o.textContent = a;
        selAksi.appendChild(o);
      });
    }

    if (selTabel) {
      selTabel.innerHTML = '<option value="">📋 Semua Tabel</option>';
      opt.tabel.forEach(t => {
        const o = document.createElement('option');
        o.value = t; o.textContent = t;
        selTabel.appendChild(o);
      });
    }
  }).getAuditFilterOptions();

  loadAudit();
}

// =============================================
// LOAD & RENDER
// =============================================
function loadAudit() {
  const container = document.getElementById('tabelAudit');
  container.innerHTML = '<p class="loading">Memuat data...</p>';

  const filter = getAuditFilter();

  google.script.run.withSuccessHandler(function(res) {
    auditData = res.items || [];
    pageAudit.page = 1;
    renderAuditTable();
  }).withFailureHandler(function(e) {
    container.innerHTML = '<p class="loading">❌ ' + e.message + '</p>';
  }).getAuditLogs(filter);
}

function getAuditFilter() {
  return {
    user: (document.getElementById('auditUser') || {}).value || '',
    aksi: (document.getElementById('auditAksi') || {}).value || '',
    tabel: (document.getElementById('auditTabel') || {}).value || '',
    dari: (document.getElementById('auditDari') || {}).value || '',
    sampai: (document.getElementById('auditSampai') || {}).value || '',
    search: (document.getElementById('auditSearch') || {}).value || ''
  };
}

function renderAuditTable() {
  const container = document.getElementById('tabelAudit');

  // Update info bar
  const infoEl = document.getElementById('auditTotalInfo');
  if (infoEl) {
    infoEl.textContent = auditData.length + ' log ditemukan';
  }

  if (!auditData.length) {
    container.innerHTML = '<p class="loading">Belum ada log untuk filter ini.</p>';
    renderPagination('paginationAudit', 0, 1, pageAudit.perPage, () => {});
    return;
  }

  const paged = paginate(auditData, pageAudit.page, pageAudit.perPage);

  let html = '<table><thead><tr>' +
    '<th>Waktu</th><th>User</th><th>Aksi</th><th>Tabel</th>' +
    '<th>Record ID</th><th>Keterangan</th><th>Status</th>' +
    '</tr></thead><tbody>';

  paged.forEach(r => {
    const aksiClass = 'audit-aksi audit-' + (r.aksi || 'unknown').toLowerCase();
    const statusClass = r.status === 'SUCCESS' ? 'status-SELESAI' : 'status-DRAFT';
    const waktu = formatAuditTime(r.timestamp);
    const userShort = r.user.length > 25 ? r.user.substring(0, 25) + '...' : r.user;

    html += `<tr>
      <td>${escapeHtml(waktu)}</td>
      <td title="${escapeHtml(r.user)}">${escapeHtml(userShort)}</td>
      <td><span class="${aksiClass}">${escapeHtml(r.aksi)}</span></td>
      <td><code style="font-size:11px;background:#f1f5f9;padding:2px 6px;border-radius:4px;">${escapeHtml(r.tabel)}</code></td>
      <td><small>${escapeHtml(r.record_id)}</small></td>
      <td>${escapeHtml(r.keterangan)}</td>
      <td><span class="status-badge ${statusClass}">${escapeHtml(r.status)}</span></td>
    </tr>`;
  });

  html += '</tbody></table>';
  container.innerHTML = html;

  renderPagination('paginationAudit', auditData.length, pageAudit.page,
    pageAudit.perPage, (newPage) => {
      pageAudit.page = newPage;
      renderAuditTable();
    });
}

function formatAuditTime(iso) {
  if (!iso) return '-';
  try {
    const d = new Date(iso);
    const dd = String(d.getDate()).padStart(2, '0');
    const mm = String(d.getMonth() + 1).padStart(2, '0');
    const yy = d.getFullYear();
    const hh = String(d.getHours()).padStart(2, '0');
    const mi = String(d.getMinutes()).padStart(2, '0');
    const ss = String(d.getSeconds()).padStart(2, '0');
    return dd + '/' + mm + '/' + yy + ' ' + hh + ':' + mi + ':' + ss;
  } catch (e) {
    return iso;
  }
}

// =============================================
// RESET FILTER
// =============================================
function resetFilterAudit() {
  ['auditUser','auditAksi','auditTabel','auditDari','auditSampai','auditSearch'].forEach(id => {
    const el = document.getElementById(id);
    if (el) el.value = '';
  });
  pageAudit.page = 1;
  loadAudit();
}

// =============================================
// BERSIHKAN LOG LAMA (> 90 hari)
// =============================================
function cleanAuditConfirm() {
  if (!confirm('Hapus log audit yang lebih dari 90 hari?\n\nLog lama akan dihapus permanen.')) return;

  showToast('⏳ Membersihkan log lama...');

  google.script.run
    .withSuccessHandler(function(res) {
      if (res.success) {
        showToast('✅ ' + res.hapus + ' log lama dihapus');
        loadAudit();
      } else {
        showToast('❌ ' + res.error, true);
      }
    })
    .withFailureHandler(function(e) {
      showToast('❌ ' + e.message, true);
    })
    .cleanAuditLogsOlderThan(90);
}

// =============================================
// EXPORT CSV
// =============================================
function exportAuditCSV() {
  if (!auditData.length) { showToast('Belum ada data', true); return; }

  let csv = 'Audit Log - SI-DATA Satpol PP Trenggalek\n';
  csv += 'Diexport: ' + new Date().toLocaleString('id-ID') + '\n\n';
  csv += 'Waktu;User;Aksi;Tabel;Record ID;Keterangan;Status\n';

  auditData.forEach(r => {
    const row = [
      formatAuditTime(r.timestamp),
      r.user,
      r.aksi,
      r.tabel,
      r.record_id,
      (r.keterangan || '').replace(/;/g, ','),
      r.status
    ];
    csv += row.join(';') + '\n';
  });

  const blob = new Blob(['\ufeff' + csv], { type: 'text/csv;charset=utf-8;' });
  const url = URL.createObjectURL(blob);
  const a = document.createElement('a');
  a.href = url;
  a.download = 'AuditLog_' + new Date().toISOString().split('T')[0] + '.csv';
  a.click();
  URL.revokeObjectURL(url);
}

