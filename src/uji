document.addEventListener('DOMContentLoaded', function() {
  const ids = ['auditUser','auditAksi','auditTabel','auditDari','auditSampai'];
  ids.forEach(id => {
    const el = document.getElementById(id);
    if (el) el.addEventListener('change', () => { pageAudit.page = 1; loadAudit(); });
  });

  const s = document.getElementById('auditSearch');
  if (s) {
    let tmr;
    s.addEventListener('input', () => {
      clearTimeout(tmr);
      tmr = setTimeout(() => { pageAudit.page = 1; loadAudit(); }, 400);
    });
  }
});
